# Cách fix lỗi font chữ trên Linux khi chạy OpenCV với Qt5
# ln -s /usr/share/fonts /media/quangnguyen/DATA/Real-Time-Exam-Proctoring-System/.venv/lib/python3.12/site-packages/cv2/qt/fonts

# Nội dung file .env
QT_QPA_FONTDIR=/usr/share/fonts
QT_QPA_PLATFORM=xcb
QT_LOGGING_RULES="*.debug=false;qt.qpa.*=false;qt.text.font.*=false"
OPENCV_LOG_LEVEL=FATAL

